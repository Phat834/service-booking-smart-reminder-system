  {
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "rootDir": ".",
      "outDir": "dist",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "moduleResolution": "node",
      "types": ["node"]
    },
    "include": ["src/**/*", "prisma/**/*", "scripts/**/*"],
    "exclude": ["node_modules", "dist"]
  }